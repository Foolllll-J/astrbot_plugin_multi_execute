{
    "simulate_allowed_users": {
        "description": "模拟使用者白名单",
        "hint": "填入允许使用「模拟」功能的用户 ID，留空表示所有人可用。管理员始终可用。",
        "type": "list",
        "items": {
            "type": "string"
        },
        "default": []
    },
    "case_insensitive_command_groups": {
        "description": "指令大小写兼容群组",
        "hint": "填入群号后，这些群聊中的英文指令、指令组和别名均支持大小写混用；留空表示关闭。",
        "type": "list",
        "items": {
            "type": "string"
        },
        "default": []
    },
    "command_access_rules": {
        "type": "template_list",
        "description": "指令黑白名单",
        "hint": "按指令、用户和群组限制指令访问。群组列表为空时，规则在所有会话生效；填写群号后，仅在指定群聊生效。",
        "default": [],
        "templates": {
            "default": {
                "name": "指令访问规则",
                "items": {
                    "commands": {
                        "description": "指令列表",
                        "hint": "填写一条或多条指令名，指令别名会跟随对应的主指令生效。",
                        "type": "list",
                        "default": [],
                        "items": {
                            "type": "string"
                        }
                    },
                    "policy": {
                        "description": "用户策略",
                        "hint": "黑名单限制名单内用户，白名单仅允许名单内用户。",
                        "type": "string",
                        "options": [
                            "黑名单",
                            "白名单"
                        ],
                        "default": "黑名单"
                    },
                    "users": {
                        "description": "用户名单",
                        "hint": "填写用户 ID。黑名单为空表示不限制；白名单为空的规则会被忽略。",
                        "type": "list",
                        "default": [],
                        "items": {
                            "type": "string"
                        }
                    },
                    "groups": {
                        "description": "群组范围",
                        "hint": "填写群号后仅在这些群聊生效；留空表示所有会话生效，包括私聊。",
                        "type": "list",
                        "default": [],
                        "items": {
                            "type": "string"
                        }
                    },
                    "notify_user": {
                        "description": "无权限时回复提示",
                        "hint": "开启后，用户触发被拦截的指令时会收到无权限提示；关闭后静默拦截。",
                        "type": "bool",
                        "default": true
                    }
                }
            }
        }
    },
    "multiply": {
        "type": "object",
        "description": "倍增指令",
        "hint": "配置倍增指令的执行间隔和最大执行次数限制。",
        "items": {
            "allowed_users": {
                "description": "倍增使用者白名单",
                "hint": "填入允许使用「倍增」功能的用户 ID，留空表示所有人可用。管理员始终可用。",
                "type": "list",
                "items": {
                    "type": "string"
                },
                "default": []
            },
            "interval": {
                "description": "执行间隔时间 (秒)",
                "hint": "连续执行指令之间的间隔时间。",
                "type": "int",
                "default": 1
            },
            "max_times": {
                "description": "最大执行次数限制",
                "hint": "单次指令连续执行的最大次数限制。",
                "type": "int",
                "default": 10
            }
        }
    },
    "no_wake": {
        "type": "object",
        "description": "免唤醒指令",
        "hint": "配置无需唤醒即可触发的指令。",
        "items": {
            "all_commands_no_wake": {
                "description": "所有指令免唤醒",
                "hint": "开启后，所有已注册的指令都无需唤醒即可触发。",
                "type": "bool",
                "default": false
            },
            "no_wake_commands": {
                "description": "免唤醒指令列表",
                "hint": "无需唤醒即可触发的指令列表。",
                "type": "list",
                "items": {
                    "type": "string"
                },
                "default": []
            },
            "no_wake_blacklist": {
                "description": "需唤醒指令列表",
                "hint": "在这些指令即使在所有指令免唤醒模式下，仍然需要唤醒。",
                "type": "list",
                "items": {
                    "type": "string"
                },
                "default": []
            },
            "no_wake_whitelist_groups": {
                "description": "免唤醒白名单群组",
                "hint": "配置允许使用免唤醒触发的群组，为空表示全局可用。",
                "type": "list",
                "items": {
                    "type": "string"
                },
                "default": []
            }
        }
    },
    "disguise": {
        "type": "template_list",
        "description": "伪装指令",
        "hint": "回复伪装：替换指令的回复内容。指令别名：将别名映射为实际指令/关键词。",
        "default": [],
        "templates": {
            "default": {
                "name": "回复伪装项",
                "items": {
                    "target_command": {
                        "description": "目标指令",
                        "hint": "支持单个命令或命令别名列表，无需唤醒前缀。",
                        "type": "list",
                        "default": [],
                        "items": {
                            "type": "string"
                        }
                    },
                    "reply_texts": {
                        "description": "回复内容",
                        "hint": "可填写多条回复，触发时随机返回一条；留空表示静默。",
                        "type": "list",
                        "default": [],
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "alias": {
                "name": "指令别名项",
                "items": {
                    "target_commands": {
                        "description": "目标指令",
                        "hint": "实际执行的指令/关键词，多条则随机触发一条。",
                        "type": "list",
                        "default": [],
                        "items": {
                            "type": "string"
                        }
                    },
                    "alias_commands": {
                        "description": "指令别名",
                        "hint": "用户可输入的别名，支持多条；任意匹配即触发。",
                        "type": "list",
                        "default": [],
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}
